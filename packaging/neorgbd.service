[Unit]
Description=NeoRGB lighting, fan and pump control
Documentation=https://github.com/Noronus/neorgb
After=graphical-session.target

[Service]
Type=simple
ExecStart=@BIN@/neorgbd
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
# On stop the daemon hands the AIO back to its stored hardware curves.
TimeoutStopSec=15

[Install]
WantedBy=default.target
